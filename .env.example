# Copiar este archivo a .env y completar. Nunca subir .env al repositorio.
# Ejemplo Gmail: usar una "contraseña de aplicación", no la contraseña normal.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=correo@gmail.com
SMTP_PASSWORD=
ALERT_EMAIL_TO=destinatario@correo.com
ALERT_EMAIL_FROM=

# Gemini: la clave también se puede guardar desde Configuración dentro de BITACORA.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_ENABLED=0
